{
  "name": "cc98-reborn-development",
  "private": true,
  "version": "0.0.0",
  "description": "Development checks for the CC98 Reborn browser extension",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "format": "node scripts/quality/check-format.mjs --write",
    "format:check": "node scripts/quality/check-format.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/quality/run-tests.mjs",
    "check:syntax": "node scripts/quality/check-syntax.mjs",
    "check:manifest": "node scripts/quality/check-manifest.mjs",
    "check:types": "wxt prepare && tsc --noEmit",
    "check:build": "node scripts/quality/check-build.mjs",
    "build": "wxt build",
    "dev": "wxt",
    "zip": "wxt zip",
    "verify": "pnpm build && pnpm run check:build && pnpm run check:types",
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:syntax && pnpm run check:manifest && pnpm run check:types && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "lucide": "1.74.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "wxt": "0.21.5"
  }
}
