<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="ControlPanelWindow"
  Title="CC98 Reborn 本地模拟论坛"
  Width="860"
  Height="690"
  MinWidth="760"
  MinHeight="610"
  WindowStartupLocation="CenterScreen"
  Background="#F5F6F8"
  FontFamily="Microsoft YaHei UI"
  FontSize="13"
  UseLayoutRounding="True"
  SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#D63384" />
    <SolidColorBrush x:Key="TextBrush" Color="#20242A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#68707C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DFE3E8" />

    <Style TargetType="Button" x:Key="CommandButton">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Margin" Value="0,0,9,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#30343A" />
      <Setter Property="BorderBrush" Value="#CDD2D8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonBorder"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource CommandButton}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#BA2872" />
          <Setter Property="BorderBrush" Value="#BA2872" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource CommandButton}">
      <Setter Property="Foreground" Value="#C53030" />
      <Setter Property="BorderBrush" Value="#E7B8B8" />
    </Style>

    <Style TargetType="TextBox" x:Key="InputBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CDD2D8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="TextBlock" x:Key="MetricLabel">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style TargetType="TextBlock" x:Key="MetricValue">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,18" Background="#F5F6F8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="2,0,2,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="CC98 Reborn 本地模拟论坛" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="独立控制本地测试服务，关闭本面板不会停止论坛。" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      <Border
        x:Name="StatusBadge"
        Grid.Column="1"
        MinWidth="112"
        Height="36"
        Padding="13,0"
        Background="#FFF4F4"
        BorderBrush="#F2B8B8"
        BorderThickness="1"
        CornerRadius="6"
        VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#C53030" Margin="0,0,8,0" />
          <TextBlock x:Name="StatusText" Text="正在检测" FontWeight="SemiBold" Foreground="#8D2525" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,17" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="监听端口" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox x:Name="PortTextBox" Grid.Column="1" Style="{StaticResource InputBox}" Width="76" MaxLength="5" Text="44303" HorizontalContentAlignment="Center" />
          <StackPanel Grid.Column="2" Margin="15,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AddressText" Text="http://127.0.0.1:44303" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="StatusDetailText" Text="正在读取服务状态..." Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
          <Button x:Name="CopyUrlButton" Grid.Column="3" Style="{StaticResource CommandButton}" Height="34" MinWidth="82" Margin="0" Content="复制地址" />
        </Grid>
        <Border Grid.Row="1" Background="#E8EBEF" />
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,15,0,0">
          <Border BorderBrush="#E8EBEF" BorderThickness="0,0,1,0" Padding="0,0,18,0">
            <StackPanel>
              <TextBlock Style="{StaticResource MetricLabel}" Text="进程 PID" />
              <TextBlock x:Name="PidValue" Style="{StaticResource MetricValue}" Text="--" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#E8EBEF" BorderThickness="0,0,1,0" Padding="18,0">
            <StackPanel>
              <TextBlock Style="{StaticResource MetricLabel}" Text="运行时长" />
              <TextBlock x:Name="UptimeValue" Style="{StaticResource MetricValue}" Text="--" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#E8EBEF" BorderThickness="0,0,1,0" Padding="18,0">
            <StackPanel>
              <TextBlock Style="{StaticResource MetricLabel}" Text="有效请求" />
              <TextBlock x:Name="RequestValue" Style="{StaticResource MetricValue}" Text="--" />
            </StackPanel>
          </Border>
          <Border Padding="18,0,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource MetricLabel}" Text="最近检测" />
              <TextBlock x:Name="LastCheckValue" Style="{StaticResource MetricValue}" Text="--" FontSize="15" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="启动" />
          <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Content="停止" />
          <Button x:Name="RestartButton" Style="{StaticResource CommandButton}" Content="重启" />
          <Button x:Name="CheckButton" Style="{StaticResource CommandButton}" Content="立即检测" Margin="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="OpenHomeButton" Style="{StaticResource CommandButton}" MinWidth="112" Content="打开论坛首页" />
          <Button x:Name="OpenEditorButton" Style="{StaticResource CommandButton}" MinWidth="132" Content="打开编辑测试页" Margin="0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0" MinHeight="160">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="17,0,11,0">
          <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
          <Button x:Name="ClearLogButton" Content="清空面板日志" Style="{StaticResource CommandButton}" HorizontalAlignment="Right" Height="30" MinWidth="102" Margin="0" Padding="10,0" FontSize="12" />
        </Grid>
        <Border Grid.Row="1" Background="#E8EBEF" />
        <TextBox
          x:Name="LogTextBox"
          Grid.Row="2"
          IsReadOnly="True"
          AcceptsReturn="True"
          TextWrapping="NoWrap"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
          BorderThickness="0"
          Padding="16,12"
          Background="#FAFBFC"
          Foreground="#3D444D"
          FontFamily="Consolas, Microsoft YaHei UI"
          FontSize="12" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="2,13,2,0">
      <CheckBox x:Name="AutoCheckBox" Content="每 2 秒自动检测" IsChecked="True" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      <TextBlock Text="服务日志保存在 tests/local-forum/.runtime" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
