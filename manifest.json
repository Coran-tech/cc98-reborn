{
  "manifest_version": 3,
  "name": "CC98 Reborn",
  "description": "A refreshed reading and browsing interface for CC98.",
  "version": "0.2.10",
  "key": "",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "browsingData",
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.cc98.org/*",
    "*://cc98.org/*",
    "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
    "*://*.webvpn.zju.edu.cn/*",
    "https://openid.cc98.org/*",
    "https://api.cc98.org/*",
    "https://api.github.com/repos/Coran-tech/cc98-reborn/releases*",
    "https://github.com/Coran-tech/cc98-reborn/releases/*",
    "https://gh-proxy.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/CC98/*",
        "images/ac/*",
        "images/ac1/*",
        "images/tb/*",
        "images/ms/*",
        "images/em/*",
        "images/mahjong/animal2017/*",
        "images/mahjong/carton2017/*",
        "images/mahjong/face2017/*"
      ],
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ],
      "exclude_matches": [
        "https://openid.cc98.org/*"
      ],
      "js": [
        "src/page-submit-monitor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ],
      "exclude_matches": [
        "https://openid.cc98.org/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "CC98 Reborn",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
