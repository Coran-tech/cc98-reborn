{
  "manifest_version": 3,
  "name": "CC98 Reborn",
  "description": "A refreshed reading and browsing interface for CC98.",
  "version": "0.4.3",
  "key": "",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "browsingData",
    "identity",
    "activeTab",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "*://*.cc98.org/*",
    "*://cc98.org/*",
    "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
    "*://*.webvpn.zju.edu.cn/*",
    "https://openid.cc98.org/*",
    "https://api.cc98.org/*",
    "https://question.coranqwq.xyz/*",
    "https://api.github.com/repos/Coran-tech/cc98-reborn/releases*",
    "https://github.com/Coran-tech/cc98-reborn/releases/*",
    "https://gh-proxy.com/*"
  ],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "web_accessible_resources": [
    {
      "resources": ["popup/popup.html", "popup/semantic-settings.html", "src/content-filter-frame.html"],
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ]
    },
    {
      "resources": [
        "images/CC98/*",
        "images/ac/*",
        "images/ac1/*",
        "images/tb/*",
        "images/ms/*",
        "images/em/*",
        "images/mahjong/animal2017/*",
        "images/mahjong/carton2017/*",
        "images/mahjong/face2017/*",
        "src/vendor/katex/fonts/*"
      ],
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.cc98.org/*", "*://cc98.org/*", "*://*.webvpn.zju.edu.cn/*"],
      "exclude_matches": ["https://openid.cc98.org/*", "*://*.webvpn.zju.edu.cn/*/connect/authorize*", "*://*.webvpn.zju.edu.cn/*/Account/LogOn*", "*://*.webvpn.zju.edu.cn/*/PassKey/LogOn*"],
      "js": ["src/topic-drawer.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.webvpn.zju.edu.cn/*"
      ],
      "js": [
        "src/openid-webvpn-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ],
      "exclude_matches": [
        "https://openid.cc98.org/*",
        "*://*.webvpn.zju.edu.cn/*/connect/authorize*",
        "*://*.webvpn.zju.edu.cn/*/Account/LogOn*",
        "*://*.webvpn.zju.edu.cn/*/PassKey/LogOn*"
      ],
      "js": [
        "src/page-submit-monitor.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.cc98.org/*",
        "*://cc98.org/*",
        "*://www-cc98-org-s.webvpn.zju.edu.cn/*",
        "*://*.webvpn.zju.edu.cn/*"
      ],
      "exclude_matches": [
        "https://openid.cc98.org/*",
        "*://*.webvpn.zju.edu.cn/*/connect/authorize*",
        "*://*.webvpn.zju.edu.cn/*/Account/LogOn*",
        "*://*.webvpn.zju.edu.cn/*/PassKey/LogOn*"
      ],
      "js": [
        "src/theme-core.js",
        "src/interface-style.js",
        "src/vendor/showdown/showdown.min.js",
        "src/vendor/katex/katex.min.js",
        "src/extended-ubb-core.js",
        "src/extended-ubb.js",
        "src/markup-converter.js",
        "src/conversation-core.js",
        "src/conversation.js",
        "src/topic-search.js",
        "src/topic-archive.js",
        "src/favorite-share-core.js",
        "src/favorite-share-service.js",
        "src/favorite-share.js",
        "src/user-notes-core.js",
        "src/user-notes.js",
        "src/private-message-pins-core.js",
        "src/private-message-pins.js",
        "src/content-filter-core.js",
        "src/content-filter.js",
        "src/semantic-filter-core.js",
        "src/semantic-filter.js",
        "src/new-topics-virtual.js",
        "src/content.js",
        "experiments/question-mark/content.js"
      ],
      "css": [
        "src/theme-tokens.css",
        "src/vendor/katex/katex.min.css",
        "src/styles.css",
        "src/user-notes.css",
        "src/topic-search.css",
        "src/topic-archive.css",
        "src/topic-drawer.css",
        "src/extended-ubb.css",
        "experiments/question-mark/content.css",
        "src/interface-styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "CC98 Reborn",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
